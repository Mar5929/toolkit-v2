{
  "description": "Toolkit V2 runtime hooks for Codex. Each one runs toolkit hook <event> through the plugin's own bin/toolkit and does nothing outside a Toolkit V2 project.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/bin/toolkit\" hook session-start --host codex",
            "timeout": 20,
            "statusMessage": "Loading the project briefing",
            "additionalContextLimit": 4000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/bin/toolkit\" hook user-prompt --host codex",
            "timeout": 10,
            "additionalContextLimit": 4000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^apply_patch$|^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/bin/toolkit\" hook pre-tool --host codex",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^apply_patch$|^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/bin/toolkit\" hook post-tool --host codex",
            "timeout": 30,
            "additionalContextLimit": 4000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/bin/toolkit\" hook stop --host codex",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
