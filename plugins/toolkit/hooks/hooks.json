{
  "description": "Toolkit V2 runtime hooks for Claude Code. Each one runs toolkit hook <event> through the plugin's own bin/toolkit and does nothing outside a Toolkit V2 project.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/toolkit", "hook", "session-start", "--host", "claude"],
            "timeout": 20,
            "statusMessage": "Loading the project briefing"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/toolkit", "hook", "user-prompt", "--host", "claude"],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/toolkit", "hook", "pre-tool", "--host", "claude"],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/toolkit", "hook", "post-tool", "--host", "claude"],
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/toolkit", "hook", "stop", "--host", "claude"],
            "timeout": 15
          }
        ]
      }
    ]
  }
}
