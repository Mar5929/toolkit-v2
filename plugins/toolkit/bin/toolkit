#!/usr/bin/env node
// The toolkit command. This small file stays plain JavaScript that any Node
// version can read, checks for Node 20 or newer, then loads lib/cli.mjs.
'use strict';

var major = Number(String(process.versions.node).split('.')[0]);
if (!(major >= 20)) {
  process.stderr.write('toolkit needs Node.js 20 or newer. This computer has Node.js ' + process.versions.node + '.\n');
  process.exit(1);
}

import('../lib/cli.mjs')
  .then(function (cli) {
    return cli.runCli(process.argv.slice(2));
  })
  .catch(function (err) {
    process.stderr.write('toolkit could not start: ' + ((err && err.stack) || err) + '\n');
    process.exitCode = 1;
  });
