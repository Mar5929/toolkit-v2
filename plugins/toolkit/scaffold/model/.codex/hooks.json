{
  "description": "Salesforce org guards for this project in Codex. Codex cannot ask for confirmation from a hook, so every guarded command that Claude Code would confirm is blocked here and handed to the owner.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.claude/hooks/guard-protected-orgs.cjs\" --host codex",
            "timeout": 90,
            "statusMessage": "Checking the Salesforce org guard"
          },
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.claude/hooks/guard-permission-set-deploy.cjs\" --host codex",
            "timeout": 30,
            "statusMessage": "Checking the permission set preflight"
          }
        ]
      }
    ]
  }
}
