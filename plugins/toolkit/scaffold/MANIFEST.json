    }
  ],
  "generated": [
    {
      "target": "AGENTS.md",
      "span": "toolkit:rules",
      "by": "toolkit init, toolkit sync",
      "condition": "always",
      "from": ".claude/rules/*.md"
    },
    {
      "target": ".toolkit.json",
      "by": "toolkit init (written last)",
      "condition": "always"
    },
    {
      "target": "ai-external-knowledge/INDEX.md",
      "by": "toolkit index knowledge",
      "condition": "always",
      "note": "Installed as a seed, then regenerated; never edited by hand."
    },
    {
      "target": ".work-items/DASHBOARD.md",
      "by": "toolkit work sync",
      "condition": "tracker:local",
      "runAtInit": true
    },
    {
      "target": ".memory/MEMORY.md",
      "by": "toolkit memory reindex",
      "condition": "memory:builtin",
      "runAtInit": true
    }
  ],
  "state": [
    {
      "target": ".work-items/.toolkit-state.json",
      "by": "toolkit work",
      "condition": "tracker:local",
      "note": "State, not generated: the ID-to-path map and the highest ID used. toolkit export includes it. Never edited by hand."
    },
    {
      "target": ".work-items/.lock",
      "by": "toolkit work",
      "condition": "tracker:local",
      "note": "Held only while a command runs."
    },
    {
      "target": ".memory/.lock",
      "by": "toolkit memory",
      "condition": "memory:builtin",
      "note": "Held only while a command runs."
    },
    {
      "target": ".toolkit-decisions.lock",
      "by": "toolkit decision add",
      "condition": "always",
      "note": "Held only while a command runs. Listed in .gitignore."
    }
  ],
  "runtime": [
    {
      "source": "templates/WORK-ITEM.md",
      "usedBy": "toolkit work new when .work-items/work-item-template/ is missing; the Notion page body; the GitHub and Jira written instructions",
      "condition": "always"
    },
    {
      "source": "templates/DESIGN.md",
      "usedBy": "toolkit work design --create when the project copy is missing; the Notion \"Solution Design\" subpage",
      "condition": "always"
    },
    {
      "source": "templates/memory/CURRENT_FOCUS.md",
      "usedBy": "toolkit notion ensure-project: the first text of the Current focus page",
      "condition": "memory:notion"
    },
    {
      "source": "templates/memory/terminology-glossary.md",
      "usedBy": "toolkit notion ensure-project: the first text of the Terminology glossary page",
      "condition": "memory:notion"
    },
    {
      "source": "templates/memory/topic-template.md",
      "usedBy": "no command reads it: a reference copy of one stored memory record (the frontmatter toolkit memory save writes, and the body sections the memory-save skill asks for)",
      "condition": "always"
    },
    {
      "source": "templates/hindsight/local.toolkit-v2.hindsight.plist.tmpl",
      "usedBy": "toolkit hindsight service install: writes ~/Library/LaunchAgents/local.toolkit-v2.hindsight.plist with {{HOME}} filled in",
      "condition": "memory:hindsight"
    },
    {
      "source": "templates/TEMPLATE-LANGUAGE.md",
      "usedBy": "documentation for init, sync, and doctor",
      "condition": "always"
    }
  ]
