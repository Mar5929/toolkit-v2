{
  "database_id": "{{TASKS_DB}}",
  "data_source_id": "{{TASKS_DS}}",
  "name": "Project tasks",
  "type": "table",
  "position": {
    "type": "start"
  },
  "filter": {
    "and": [
      {
        "property": "{{T_TASK_TYPE}}",
        "formula": {
          "string": {
            "equals": "Project"
          }
        }
      },
      {
        "property": "{{T_PHASE}}",
        "relation": {
          "is_empty": true
        }
      }
    ]
  },
  "sorts": [
    {
      "property": "{{T_ORDER}}",
      "direction": "ascending"
    }
  ],
  "configuration": {
    "type": "table",
    "properties": [
      {
        "property_id": "{{T_TASK_ID}}",
        "visible": true
      },
      {
        "property_id": "{{T_STATUS}}",
        "visible": true
      },
      {
        "property_id": "{{T_WHO_DOES_IT}}",
        "visible": true
      },
      {
        "property_id": "{{T_DONE_WHEN}}",
        "visible": true
      },
      {
        "property_id": "{{T_ORDER}}",
        "visible": false
      }
    ]
  }
}
