{
  "database_id": "{{TASKS_DB}}",
  "data_source_id": "{{TASKS_DS}}",
  "name": "Open tasks",
  "type": "table",
  "position": {
    "type": "start"
  },
  "filter": {
    "and": [
      {
        "property": "{{T_STATUS}}",
        "status": {
          "does_not_equal": "Done"
        }
      },
      {
        "property": "{{T_STATUS}}",
        "status": {
          "does_not_equal": "Cancelled"
        }
      }
    ]
  },
  "sorts": [
    {
      "property": "{{T_ORDER}}",
      "direction": "ascending"
    }
  ],
  "configuration": {
    "type": "table",
    "group_by": {
      "type": "relation",
      "property_id": "{{T_WORK_ITEM}}",
      "sort": {
        "type": "ascending"
      },
      "hide_empty_groups": true
    },
    "properties": [
      {
        "property_id": "{{T_TASK_ID}}",
        "visible": true
      },
      {
        "property_id": "{{T_STATUS}}",
        "visible": true
      },
      {
        "property_id": "{{T_WHO_DOES_IT}}",
        "visible": true
      },
      {
        "property_id": "{{T_DONE_WHEN}}",
        "visible": true
      },
      {
        "property_id": "{{T_PHASE}}",
        "visible": true
      }
    ]
  }
}
