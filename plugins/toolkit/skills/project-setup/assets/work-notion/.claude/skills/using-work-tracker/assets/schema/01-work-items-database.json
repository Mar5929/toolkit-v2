{
  "parent": {
    "type": "page_id",
    "page_id": "{{PROJECT_PAGE_ID}}"
  },
  "title": [
    {
      "type": "text",
      "text": {
        "content": "Work Items"
      }
    }
  ],
  "is_inline": true,
  "icon": {
    "type": "emoji",
    "emoji": "🗂️"
  },
  "initial_data_source": {
    "properties": {
      "Work item": {
        "title": {}
      },
      "ID": {
        "unique_id": {
          "prefix": null
        }
      },
      "Status": {
        "status": {
          "options": [
            {
              "name": "Not Started",
              "color": "gray",
              "group": "To-do"
            },
            {
              "name": "Preparing",
              "color": "blue",
              "group": "In progress"
            },
            {
              "name": "In Progress",
              "color": "yellow",
              "group": "In progress"
            },
            {
              "name": "Blocked",
              "color": "red",
              "group": "In progress"
            },
            {
              "name": "Done",
              "color": "green",
              "group": "Complete"
            },
            {
              "name": "Cancelled",
              "color": "brown",
              "group": "Complete"
            }
          ]
        }
      },
      "State": {
        "select": {
          "options": [
            {
              "name": "Backlog",
              "color": "gray"
            },
            {
              "name": "Refining Requirements",
              "color": "blue"
            },
            {
              "name": "Designing",
              "color": "purple"
            },
            {
              "name": "Building",
              "color": "orange"
            },
            {
              "name": "Testing Loop",
              "color": "yellow"
            },
            {
              "name": "Reflecting",
              "color": "pink"
            },
            {
              "name": "Deploying",
              "color": "green"
            },
            {
              "name": "Blocked",
              "color": "red"
            },
            {
              "name": "Done",
              "color": "default"
            },
            {
              "name": "Cancelled",
              "color": "brown"
            }
          ]
        }
      },
      "Waiting on": {
        "select": {
          "options": [
            {
              "name": "owner",
              "color": "red"
            },
            {
              "name": "agent",
              "color": "blue"
            },
            {
              "name": "external",
              "color": "orange"
            },
            {
              "name": "none",
              "color": "gray"
            }
          ]
        },
        "description": "Who the item waits on. The Current state Waiting on line on the page says who and for what."
      },
      "Type": {
        "select": {
          "options": [
            {
              "name": "discovery",
              "description": "Finding out what is needed."
            },
            {
              "name": "solution-design",
              "description": "Designing how something gets built."
            },
            {
              "name": "build",
              "description": "Producing a change."
            },
            {
              "name": "data-load",
              "description": "Loading or changing data."
            },
            {
              "name": "repository-maintenance",
              "description": "Keeping the repository in order."
            },
            {
              "name": "research",
              "description": "Answering a question with sources."
            },
            {
              "name": "task",
              "description": "A small piece of work."
            },
            {
              "name": "bug",
              "description": "Something that does not work as it should."
            },
            {
              "name": "enhancement",
              "description": "An improvement to something that works."
            }
          ]
        }
      },
      "Priority": {
        "select": {
          "options": [
            {
              "name": "urgent",
              "color": "red"
            },
            {
              "name": "high",
              "color": "orange"
            },
            {
              "name": "medium",
              "color": "yellow"
            },
            {
              "name": "low",
              "color": "gray"
            }
          ]
        }
      },
      "Tags": {
        "multi_select": {
          "options": []
        },
        "description": "Free labels. Add new ones as needed."
      },
      "Next action": {
        "rich_text": {},
        "description": "A copy of the Current state \"Next action\" line, so a board card shows it."
      },
      "Requirements approved": {
        "rich_text": {},
        "description": "\"YYYY-MM-DD by <name>\", or \"no\"."
      },
      "Design": {
        "select": {
          "options": [
            {
              "name": "none",
              "color": "gray"
            },
            {
              "name": "proposed",
              "color": "yellow"
            },
            {
              "name": "approved",
              "color": "green"
            },
            {
              "name": "superseded",
              "color": "brown"
            }
          ]
        }
      },
      "Design approved": {
        "rich_text": {},
        "description": "\"YYYY-MM-DD by <name>\", or \"no\"."
      },
      "Result approved": {
        "rich_text": {},
        "description": "\"YYYY-MM-DD by <name>\", or \"no\"."
      },
      "Delivery": {
        "select": {
          "options": [
            {
              "name": "not-offered",
              "color": "gray"
            },
            {
              "name": "agent-led",
              "color": "blue"
            },
            {
              "name": "owner-led",
              "color": "green"
            }
          ]
        }
      },
      "Files": {
        "files": {},
        "description": "Files the owner attached himself. The agent adds none: an original is filed in sources/."
      },
      "Archived": {
        "checkbox": {},
        "description": "Hidden from the boards."
      }
    }
  }
}
