# Generated file. Source: plugins/toolkit/templates/codex/toolkit.rules. Edit the source, then run node dev/tools/sync-skill-references.mjs.
# Codex command rules for this project, written by toolkit init.
# The toolkit command runs outside the Codex sandbox without a prompt. It needs
# the network for Notion and the local Hindsight server, and it writes the work
# tracker and memory in the main checkout, which a worktree cannot reach.
# Run each toolkit command on its own line so this rule matches it.
#
# Seven toolkit commands change things that are hard or impossible to undo,
# or change every project on this computer, so Codex asks the owner before
# each one (Mike, 2026-09-28, decision 12; toolkit rule --machine, 2026-09-29). When
# several rules match a command, the strictest decision wins, so these prompt
# rules hold even though the general rule below allows every toolkit command.
# The approval alone does not move the command out of the sandbox: the agent
# must also ask for escalated permissions (sandbox_permissions
# "require_escalated") with a one-line reason, or the approved command still
# runs inside the sandbox and fails. Inside it, toolkit memory delete cannot
# reach Hindsight or Notion, toolkit machine-setup cannot write
# ~/.codex/config.toml or ~/.local/bin, toolkit hindsight service install
# cannot write ~/Library/LaunchAgents, toolkit rule add --machine cannot write
# ~/.claude/rules, and toolkit import run from a worktree cannot write the
# main checkout. With approvals turned off (codex exec),
# Codex refuses these commands without asking; the agent then shows the owner
# the exact command to run in a terminal. The toolkit refuses these commands
# when a flag such as --json is written before the command words, because
# these rules would not match that form.

prefix_rule(
    pattern = ["toolkit", "machine-setup"],
    decision = "prompt",
    justification = "toolkit machine-setup changes this computer: ~/.codex/config.toml, ~/.local/bin/toolkit, and ~/.config/toolkit-v2. It runs only after the owner's yes. Run it alone with sandbox_permissions require_escalated.",
    match = ["toolkit machine-setup", "toolkit machine-setup --offline"],
    not_match = ["toolkit doctor"],
)

prefix_rule(
    pattern = ["toolkit", "memory", ["delete", "import"]],
    decision = "prompt",
    justification = "toolkit memory delete removes a memory record for good, and toolkit memory import replaces records. It runs only after the owner's yes. Run it alone with sandbox_permissions require_escalated.",
    match = ["toolkit memory delete project_old_fact --owner-approved", "toolkit memory import --from backup"],
    not_match = ["toolkit memory find billing", "toolkit memory save --type project --name x --description y --body z"],
)

prefix_rule(
    pattern = ["toolkit", "import"],
    decision = "prompt",
    justification = "toolkit import writes .work-items/ and .memory/ from a backup and can replace files. It runs only after the owner's yes. Run it alone with sandbox_permissions require_escalated.",
    match = ["toolkit import --from backup", "toolkit import --from backup --replace"],
    not_match = ["toolkit export --to backup"],
)

prefix_rule(
    pattern = ["toolkit", "hindsight", "service", ["install", "start"]],
    decision = "prompt",
    justification = "This installs or starts the Hindsight background service on this computer. It runs only after the owner's yes. Run it alone with sandbox_permissions require_escalated.",
    match = ["toolkit hindsight service install", "toolkit hindsight service start"],
    not_match = ["toolkit hindsight service status", "toolkit hindsight health"],
)

prefix_rule(
    pattern = ["toolkit", "rule", ["add", "update"], "--machine"],
    decision = "prompt",
    justification = "toolkit rule add --machine or update --machine changes the owner's rules for every project on this computer (~/.claude/rules/owner-preferences.md). It runs only after the owner's yes. Run it alone with sandbox_permissions require_escalated.",
    match = ["toolkit rule add --machine --section Replies --text 'Lead with the answer.' --source 'Mike in chat'", "toolkit rule update --machine --section Replies --entry 1 --remove"],
    not_match = ["toolkit rule add --section Replies --text 'Lead with the answer.' --source 'Mike in chat'", "toolkit rule list --machine"],
)

prefix_rule(
    pattern = ["toolkit"],
    decision = "allow",
    justification = "Toolkit V2 command: updates the work tracker and memory in the main checkout and calls Notion and the local Hindsight server.",
    match = ["toolkit work sync", "toolkit memory find billing"],
)

# Git commands that write .git/. The Codex sandbox keeps .git/ read-only, so
# these can never run inside it. Codex asks the owner before each one. The
# approval alone does not move the command out of the sandbox: the agent must
# also ask for escalated permissions (sandbox_permissions "require_escalated")
# with a one-line reason, or the approved command still fails on
# .git/index.lock. With approvals turned off (codex exec), Codex refuses these
# commands without asking; the agent then shows the owner the exact command to
# run in a terminal. Reading commands (git status, git log, git diff,
# git branch --list) are not listed and run as before.

prefix_rule(
    pattern = ["git", ["add", "commit", "merge", "fetch", "pull", "push", "switch", "checkout", "restore", "rm", "mv", "stash", "cherry-pick", "revert"]],
    decision = "prompt",
    justification = "Git writes .git/, which the Codex sandbox keeps read-only. It runs only with the owner's approval and escalated permissions (outside the sandbox).",
    match = ["git add src/greet.js", "git commit -m 'Add greeting'", "git merge --ff-only claude/wi-001-greet"],
    not_match = ["git status", "git log --oneline -5"],
)

prefix_rule(
    pattern = ["git", "worktree", ["add", "remove", "move", "prune", "repair"]],
    decision = "prompt",
    justification = "A worktree is made or removed in .git/, which the Codex sandbox keeps read-only. It runs only with the owner's approval and escalated permissions (outside the sandbox).",
    match = ["git worktree add .claude/worktrees/wi-001-greet -b claude/wi-001-greet"],
    not_match = ["git worktree list"],
)

prefix_rule(
    pattern = ["git", "branch", ["-d", "-D", "--delete", "-m", "-M", "--move", "-c", "-C", "--copy"]],
    decision = "prompt",
    justification = "Deleting, renaming, or copying a branch writes .git/, which the Codex sandbox keeps read-only. It runs only with the owner's approval and escalated permissions (outside the sandbox).",
    match = ["git branch -d claude/wi-001-greet"],
    not_match = ["git branch --show-current"],
)
