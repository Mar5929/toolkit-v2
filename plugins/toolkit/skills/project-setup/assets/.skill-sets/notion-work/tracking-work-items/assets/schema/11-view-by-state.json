{
  "database_id": "{{WORK_ITEMS_DB}}",
  "data_source_id": "{{WORK_ITEMS_DS}}",
  "name": "By state",
  "type": "board",
  "position": {
    "type": "end"
  },
  "filter": {
    "and": [
      {
        "property": "{{P_STATUS}}",
        "status": {
          "does_not_equal": "Done"
        }
      },
      {
        "property": "{{P_STATUS}}",
        "status": {
          "does_not_equal": "Cancelled"
        }
      },
      {
        "property": "{{P_ARCHIVED}}",
        "checkbox": {
          "equals": false
        }
      },
      {
        "property": "title",
        "title": {
          "is_not_empty": true
        }
      }
    ]
  },
  "sorts": [
    {
      "property": "{{P_PRIORITY}}",
      "direction": "ascending"
    },
    {
      "property": "{{P_ID}}",
      "direction": "ascending"
    }
  ],
  "configuration": {
    "type": "board",
    "group_by": {
      "type": "select",
      "property_id": "{{P_STATE}}",
      "sort": {
        "type": "ascending"
      },
      "hide_empty_groups": true
    },
    "properties": [
      {
        "property_id": "{{P_ID}}",
        "visible": true
      },
      {
        "property_id": "{{P_STATUS}}",
        "visible": true
      },
      {
        "property_id": "{{P_WAITING_ON}}",
        "visible": true
      },
      {
        "property_id": "{{P_PRIORITY}}",
        "visible": true
      },
      {
        "property_id": "{{P_PARENT_ITEM}}",
        "visible": true
      }
    ]
  }
}
