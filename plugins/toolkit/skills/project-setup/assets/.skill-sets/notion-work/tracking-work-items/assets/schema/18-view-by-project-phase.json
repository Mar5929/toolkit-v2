{
  "database_id": "{{WORK_ITEMS_DB}}",
  "data_source_id": "{{WORK_ITEMS_DS}}",
  "name": "By project phase",
  "type": "board",
  "position": {
    "type": "start"
  },
  "filter": {
    "and": [
      {
        "property": "{{P_PARENT_ITEM}}",
        "relation": {
          "is_empty": true
        }
      },
      {
        "property": "{{P_ARCHIVED}}",
        "checkbox": {
          "equals": false
        }
      },
      {
        "property": "title",
        "title": {
          "is_not_empty": true
        }
      }
    ]
  },
  "sorts": [
    {
      "property": "{{P_PRIORITY}}",
      "direction": "ascending"
    },
    {
      "property": "{{P_ID}}",
      "direction": "ascending"
    }
  ],
  "configuration": {
    "type": "board",
    "group_by": {
      "type": "formula",
      "property_id": "{{P_PHASE_COLUMN}}",
      "group_by": {
        "type": "text",
        "group_by": "exact",
        "sort": {
          "type": "ascending"
        }
      },
      "hide_empty_groups": true
    },
    "properties": [
      {
        "property_id": "{{P_ID}}",
        "visible": true
      },
      {
        "property_id": "{{P_STATUS}}",
        "visible": true
      },
      {
        "property_id": "{{P_STATE}}",
        "visible": true
      },
      {
        "property_id": "{{P_WAITING_ON}}",
        "visible": true
      },
      {
        "property_id": "{{P_NEXT_ACTION}}",
        "visible": true
      }
    ]
  }
}
