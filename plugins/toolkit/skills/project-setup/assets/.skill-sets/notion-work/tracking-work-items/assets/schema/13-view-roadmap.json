{
  "database_id": "{{WORK_ITEMS_DB}}",
  "data_source_id": "{{WORK_ITEMS_DS}}",
  "name": "Roadmap",
  "type": "table",
  "position": {
    "type": "end"
  },
  "filter": {
    "and": [
      {
        "property": "{{P_PARENT_ITEM}}",
        "relation": {
          "is_not_empty": true
        }
      },
      {
        "property": "{{P_ARCHIVED}}",
        "checkbox": {
          "equals": false
        }
      },
      {
        "property": "title",
        "title": {
          "is_not_empty": true
        }
      }
    ]
  },
  "sorts": [
    {
      "property": "{{P_PHASE_ORDER}}",
      "direction": "ascending"
    },
    {
      "property": "{{P_ID}}",
      "direction": "ascending"
    }
  ],
  "configuration": {
    "type": "table",
    "group_by": {
      "type": "relation",
      "property_id": "{{P_PARENT_ITEM}}",
      "sort": {
        "type": "ascending"
      },
      "hide_empty_groups": true
    },
    "properties": [
      {
        "property_id": "{{P_ID}}",
        "visible": true
      },
      {
        "property_id": "{{P_STATUS}}",
        "visible": true
      },
      {
        "property_id": "{{P_STATE}}",
        "visible": true
      },
      {
        "property_id": "{{P_WAITING_ON}}",
        "visible": true
      },
      {
        "property_id": "{{P_PHASE}}",
        "visible": true
      },
      {
        "property_id": "{{P_BLOCKED_BY}}",
        "visible": true
      }
    ]
  }
}
