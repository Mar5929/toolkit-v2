{
  "create_database": {
    "parent": {
      "type": "page_id",
      "page_id": "{{ITEM_PAGE_ID}}"
    },
    "position": {
      "type": "after_block",
      "block_id": "{{AFTER_BLOCK_ID}}"
    }
  },
  "data_source_id": "{{TASKS_DS}}",
  "name": "Tasks",
  "type": "table",
  "filter": {
    "property": "{{T_WORK_ITEM}}",
    "relation": {
      "contains": "{{ITEM_PAGE_ID}}"
    }
  },
  "sorts": [
    {
      "property": "{{T_ORDER}}",
      "direction": "ascending"
    }
  ],
  "configuration": {
    "type": "table",
    "group_by": {
      "type": "relation",
      "property_id": "{{T_PHASE}}",
      "sort": {
        "type": "ascending"
      },
      "hide_empty_groups": true
    },
    "properties": [
      {
        "property_id": "{{T_TASK_ID}}",
        "visible": true
      },
      {
        "property_id": "{{T_DONE}}",
        "visible": true
      },
      {
        "property_id": "{{T_DONE_WHEN}}",
        "visible": true
      },
      {
        "property_id": "{{T_ORDER}}",
        "visible": false
      }
    ]
  }
}
