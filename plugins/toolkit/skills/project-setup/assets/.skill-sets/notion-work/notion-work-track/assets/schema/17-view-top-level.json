{
  "database_id": "{{WORK_ITEMS_DB}}",
  "data_source_id": "{{WORK_ITEMS_DS}}",
  "name": "Top-level items",
  "type": "table",
  "position": {
    "type": "end"
  },
  "filter": {
    "and": [
      {
        "property": "{{P_PARENT_ITEM}}",
        "relation": {
          "is_empty": true
        }
      },
      {
        "property": "{{P_ARCHIVED}}",
        "checkbox": {
          "equals": false
        }
      },
      {
        "property": "title",
        "title": {
          "is_not_empty": true
        }
      }
    ]
  },
  "sorts": [
    {
      "property": "{{P_PRIORITY}}",
      "direction": "ascending"
    },
    {
      "property": "{{P_ID}}",
      "direction": "ascending"
    }
  ],
  "configuration": {
    "type": "table",
    "properties": [
      {
        "property_id": "{{P_ID}}",
        "visible": true
      },
      {
        "property_id": "{{P_STATUS}}",
        "visible": true
      },
      {
        "property_id": "{{P_STAGE}}",
        "visible": true
      },
      {
        "property_id": "{{P_BLOCKED_BY}}",
        "visible": true
      },
      {
        "property_id": "{{P_BLOCKING}}",
        "visible": true
      },
      {
        "property_id": "{{P_NEXT_ACTION}}",
        "visible": true
      }
    ]
  }
}
