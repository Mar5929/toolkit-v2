{
  "create_database": {
    "parent": {
      "type": "page_id",
      "page_id": "{{ITEM_PAGE_ID}}"
    },
    "position": {
      "type": "after_block",
      "block_id": "{{AFTER_BLOCK_ID}}"
    }
  },
  "data_source_id": "{{PHASES_DS}}",
  "name": "Phases",
  "type": "table",
  "filter": {
    "property": "{{PH_WORK_ITEM}}",
    "relation": {
      "contains": "{{ITEM_PAGE_ID}}"
    }
  },
  "sorts": [
    {
      "property": "{{PH_ORDER}}",
      "direction": "ascending"
    }
  ],
  "configuration": {
    "type": "table",
    "properties": [
      {
        "property_id": "{{PH_PHASE_ID}}",
        "visible": true
      },
      {
        "property_id": "{{PH_STATUS}}",
        "visible": true
      },
      {
        "property_id": "{{PH_OUTCOME}}",
        "visible": true
      },
      {
        "property_id": "{{PH_EXIT_RESULT}}",
        "visible": true
      },
      {
        "property_id": "{{PH_SUB_ITEMS}}",
        "visible": true
      },
      {
        "property_id": "{{PH_ORDER}}",
        "visible": false
      },
      {
        "property_id": "{{PH_WORK_ITEM}}",
        "visible": false
      }
    ]
  }
}
