{
  "autoMemoryEnabled": false,
  "claudeMdExcludes": [
    "**/plugins/toolkit/skills/project-setup/every-project/**",
    "**/plugins/toolkit/skills/project-setup/choices/**",
    "**/plugins/toolkit/skills/project-setup/assets/**"
  ],
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "-e",
              "try { const rule = require('node:fs').readFileSync(process.argv[1], 'utf8'); process.stdout.on('error', () => {}).write(\"The owner's rule for every request, from .claude/rules/evaluate-the-owners-request.md. Where owner-preferences.md says otherwise, that file wins:\\n\" + rule); } catch {}",
              "${CLAUDE_PROJECT_DIR}/plugins/toolkit/skills/project-setup/every-project/.claude/rules/evaluate-the-owners-request.md"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  },
  "skillOverrides": {
    "braindump": "off",
    "filechanges": "off",
    "filing-project-records": "off",
    "handoff": "off",
    "managing-project-memory": "off",
    "managing-work-items": "off",
    "merge-and-clean-up": "off",
    "publish-docs": "off",
    "pull-latest": "off",
    "reset-to-remote": "off",
    "session-summary": "off",
    "sf-component-tracker": "off",
    "sf-data-change": "off",
    "sf-deploy-check": "off",
    "using-notion-cli": "off"
  }
}
