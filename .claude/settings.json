{
  "autoMemoryEnabled": false,
  "outputStyle": "Plain English",
  "claudeMdExcludes": [
    "**/plugins/toolkit/skills/project-setup/every-project/**",
    "**/plugins/toolkit/skills/project-setup/choices/**"
  ],
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/prompt-reminder.mjs",
              "--skill",
              "hindsight"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  },
  "skillOverrides": {
    "braindump": "off",
    "filing-project-records": "off",
    "handoff": "off",
    "managing-project-memory": "off",
    "managing-work-items": "off",
    "merge-and-clean-up": "off",
    "publish-docs": "off",
    "pull-latest": "off",
    "reset-to-remote": "off",
    "session-summary": "off",
    "shaping-a-prompt": "off",
    "sf-component-tracker": "off",
    "sf-data-change": "off",
    "sf-deploy-check": "off",
    "using-notion-cli": "off",
    "maintaining-notion-wiki": "off"
  }
}
